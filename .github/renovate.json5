{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  prHourlyLimit: 0,
  schedule: [
    'after 6am and before 4pm on sunday',
  ],
  timezone: 'Asia/Jerusalem',
  platformAutomerge: true,
  prConcurrentLimit: 10,
  ignoreDeps: [
    'lscr.io/linuxserver/jellyfin',
    'ghcr.io/elfhosted/newtarr',
  ],
  packageRules: [
    {
      description: 'Use docker versioning for all Docker Compose images: it handles the v-prefix, zero-padded calver months (pihole 2026.04.0), and treats variant suffixes like trawl -baseline as incompatible.',
      matchManagers: [
        'docker-compose',
      ],
      matchDatasources: [
        'docker',
      ],
      versioning: 'docker',
    },
    {
      description: 'Docker Compose major image updates',
      matchManagers: [
        'docker-compose',
      ],
      matchDatasources: [
        'docker',
      ],
      commitMessagePrefix: 'deps(compose):',
      matchUpdateTypes: [
        'major',
      ],
      minimumReleaseAge: '21 days',
      automerge: false,
      platformAutomerge: false,
    },
    {
      description: 'Auto-merge Docker Compose minor updates',
      matchManagers: [
        'docker-compose',
      ],
      matchDatasources: [
        'docker',
      ],
      commitMessagePrefix: 'deps(compose):',
      matchUpdateTypes: [
        'minor',
      ],
      minimumReleaseAge: '7 days',
      automerge: true,
      automergeType: 'pr',
      automergeStrategy: 'squash',
    },
    {
      description: 'Auto-merge Docker Compose patch updates',
      matchManagers: [
        'docker-compose',
      ],
      matchDatasources: [
        'docker',
      ],
      commitMessagePrefix: 'deps(compose):',
      matchUpdateTypes: [
        'patch',
      ],
      automerge: true,
      automergeType: 'pr',
      automergeStrategy: 'squash',
    },
  ],
  ignoreTests: true,
  // Create branches only after minimumReleaseAge has passed, so the release-age
  // 'pending' status check never blocks PR creation (it can get stuck forever
  // when branches have no CI checks — see renovatebot discussions #18793/#21720).
  internalChecksFilter: 'strict',
}
