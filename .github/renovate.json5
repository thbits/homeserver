{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  prHourlyLimit: 0,
  schedule: [
    'after 6am and before 4pm on sunday',
  ],
  timezone: 'Asia/Jerusalem',
  platformAutomerge: true,
  prConcurrentLimit: 10,
  ignoreDeps: [
    'lscr.io/linuxserver/jellyfin',
    'ghcr.io/elfhosted/newtarr',
  ],
  packageRules: [
    {
      description: 'linuxserver qbittorrent has a stale 20.04.1 tag (old base-image versioning); stay on the real 5.x line.',
      matchPackageNames: [
        'lscr.io/linuxserver/qbittorrent',
      ],
      allowedVersions: '<6',
    },
    {
      description: 'Use docker versioning for all Docker Compose images: it handles the v-prefix, zero-padded calver months (pihole 2026.04.0), and treats variant suffixes like trawl -baseline as incompatible.',
      matchManagers: [
        'docker-compose',
      ],
      matchDatasources: [
        'docker',
      ],
      versioning: 'docker',
    },
    {
      description: 'Docker Compose major image updates',
      matchManagers: [
        'docker-compose',
      ],
      matchDatasources: [
        'docker',
      ],
      commitMessagePrefix: 'deps(compose):',
      matchUpdateTypes: [
        'major',
      ],
      minimumReleaseAge: '21 days',
      automerge: false,
      platformAutomerge: false,
    },
    {
      description: 'Auto-merge Docker Compose minor updates',
      matchManagers: [
        'docker-compose',
      ],
      matchDatasources: [
        'docker',
      ],
      commitMessagePrefix: 'deps(compose):',
      matchUpdateTypes: [
        'minor',
      ],
      minimumReleaseAge: '7 days',
      automerge: true,
      automergeType: 'pr',
      automergeStrategy: 'squash',
    },
    {
      description: 'Auto-merge Docker Compose patch updates',
      matchManagers: [
        'docker-compose',
      ],
      matchDatasources: [
        'docker',
      ],
      commitMessagePrefix: 'deps(compose):',
      matchUpdateTypes: [
        'patch',
      ],
      automerge: true,
      automergeType: 'pr',
      automergeStrategy: 'squash',
    },
  ],
  ignoreTests: true,
  // Create branches only after minimumReleaseAge has passed, so the release-age
  // 'pending' status check never blocks PR creation.
  internalChecksFilter: 'strict',
  // Only Docker Hub exposes release timestamps. Since Renovate 42 the default
  // (timestamp-required) holds every ghcr.io/lscr.io update forever under
  // "Pending Status Checks". Treat a missing timestamp as old enough instead.
  minimumReleaseAgeBehaviour: 'timestamp-optional',
}
